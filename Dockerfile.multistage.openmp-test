ARG BASE_IMAGE=ubuntu:24.04

# Utilities for downloading packages
FROM ${BASE_IMAGE} AS downloader

# this env variable prevents the apt-get installs from asking for user input
ENV DEBIAN_FRONTEND=noninteractive

# Bump the date to current to refresh curl/certificates/etc
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
                    binutils \
                    bzip2 \
                    ca-certificates \
                    tcsh \
                    curl \
                    unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

## Freesurfer Build Stage
FROM downloader AS freesurfer

ENV DEBIAN_FRONTEND=noninteractive
ENV FREESURFER_HOME=/usr/local/freesurfer/8.2.0

RUN apt update && \
    apt install -y bc binutils libgomp1 perl psmisc sudo tar tcsh unzip uuid-dev vim-common libjpeg62-dev wget software-properties-common && \
    add-apt-repository universe -y && \
    apt update

# use `apt install ./pkg.deb` rather than gdebi: apt does full transitive
# dependency resolution (needed for libinsighttoolkit5.3 et al.), gdebi -n
# was silently skipping unresolved deps instead of installing them.
RUN wget https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/8.2.0/freesurfer_ubuntu24-8.2.0_amd64.deb && \
    apt-get install -y ./freesurfer_ubuntu24-8.2.0_amd64.deb && \
    rm -rf $FREESURFER_HOME/diffusion && \
    rm -rf $FREESURFER_HOME/docs && \
    rm -rf $FREESURFER_HOME/fsfast && \
    rm -rf $FREESURFER_HOME/lib/cuda && \
    rm -rf $FREESURFER_HOME/matlab && \
    rm -rf $FREESURFER_HOME/mni/share/man && \
    rm -rf $FREESURFER_HOME/subjects/fsaverage_sym && \
    rm -rf $FREESURFER_HOME/subjects/fsaverage3 && \
    rm -rf $FREESURFER_HOME/subjects/fsaverage4 && \
    rm -rf $FREESURFER_HOME/subjects/cvs_avg35 && \
    rm -rf $FREESURFER_HOME/subjects/cvs_avg35_inMNI152 && \
    rm -rf $FREESURFER_HOME/subjects/bert && \
    rm -rf $FREESURFER_HOME/subjects/lh.EC_average && \
    rm -rf $FREESURFER_HOME/subjects/rh.EC_average && \
    rm -rf $FREESURFER_HOME/subjects/sample-*.mgz && \
    rm -rf $FREESURFER_HOME/subjects/V1_average && \
    rm -rf $FREESURFER_HOME/trctrain && \
    rm freesurfer_ubuntu24-8.2.0_amd64.deb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

## AFNI Build Stage
FROM downloader AS afni

ARG AFNI_PREFIX="/sw/apps/afni"
RUN mkdir -p $AFNI_PREFIX && \
    cd $AFNI_PREFIX && \
    curl -O https://afni.nimh.nih.gov/pub/dist/bin/misc/@update.afni.binaries && \
    tcsh @update.afni.binaries -package linux_ubuntu_24_64 -do_extras && \
    mv ~/abin/ /sw/apps/afni/

## ANTS Build Stage
FROM downloader AS ants

# install ants
ARG ANTS_PREFIX="/sw/apps/ants"

RUN mkdir -p $ANTS_PREFIX

RUN curl -L -s -o ANTS.zip https://github.com/ANTsX/ANTs/releases/download/v2.6.5/ants-2.6.5-ubuntu-24.04-X64-gcc.zip && \
    unzip ANTS.zip -d $ANTS_PREFIX && \
    mv $ANTS_PREFIX/ants-2.6.5/bin $ANTS_PREFIX && \
    mv $ANTS_PREFIX/ants-2.6.5/lib $ANTS_PREFIX && \
    rmdir $ANTS_PREFIX/ants-2.6.5

## dcm2niix Build Stage

FROM downloader AS dcm2niix

# install dcm2niix
ARG D2N_PREFIX="/sw/apps/dcm2niix"
ARG D2N_URI="https://github.com/rordenlab/dcm2niix/releases/download/v1.0.20260724/dcm2niix_lnx.zip"
RUN mkdir -p $D2N_PREFIX && \
    curl -sL $D2N_URI -o $D2N_PREFIX/dcm2niix_lnx.zip && \
    unzip $D2N_PREFIX/dcm2niix_lnx.zip -d $D2N_PREFIX && \
    rm $D2N_PREFIX/dcm2niix_lnx.zip

## FSL Build Stage
FROM downloader AS fsl

# install fsl
ARG FSL_PREFIX="/sw/apps/fsl"
ARG FSL_VERSION="6.0.7.18"
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
RUN mkdir -p "$(dirname "${FSL_PREFIX}")" && \
    curl -fsSL -o /tmp/fslinstaller.py \
      https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/releases/fslinstaller.py && \
    python3 /tmp/fslinstaller.py -d "${FSL_PREFIX}" -V "${FSL_VERSION}" --skip_registration && \
    rm -f /tmp/fslinstaller.py

## Main Stage

# starting from the base image
FROM $BASE_IMAGE

# install run time utilies
RUN apt-get update && \
    apt-get install -y git nano python3 python3-pip bc perl tar tcsh wget vim-common && \
    apt-get clean

# compatibility shim: morphometry's provenance() shells out to
# `cat /etc/system-release`, which only exists on RHEL/CentOS - fake it here
# so provenance logging doesn't crash on this Ubuntu base. Real fix belongs
# upstream in morphometry (fall back to /etc/os-release).
RUN echo "Ubuntu $(. /etc/os-release && echo "$VERSION")" > /etc/system-release

# install pipenv
RUN pip3 install --break-system-packages pipenv==2026.7.1

# Install MRIQC
ARG MRIQC_VERSION="24.0.2"
ARG MRIQC_PREFIX="/sw/apps/mriqc"
RUN mkdir -p "${MRIQC_PREFIX}"
ENV PIPENV_VENV_IN_PROJECT=1
WORKDIR "${MRIQC_PREFIX}"
ENV LANG=C.UTF-8
RUN pipenv install "mriqc==${MRIQC_VERSION}"

# Install dependent software
ARG FS_PREFIX=/sw/apps/freesurfer
ARG AFNI_PREFIX=/sw/apps/afni
ARG ANTS_PREFIX=/sw/apps/ants
ARG D2N_PREFIX=/sw/apps/dcm2niix
ARG FSL_PREFIX=/sw/apps/fsl

COPY --from=freesurfer /usr/local/freesurfer/8.2.0 $FS_PREFIX
COPY --from=afni $AFNI_PREFIX $AFNI_PREFIX
COPY --from=ants $ANTS_PREFIX $ANTS_PREFIX
COPY --from=dcm2niix $D2N_PREFIX $D2N_PREFIX
COPY --from=fsl $FSL_PREFIX $FSL_PREFIX

# set up freesurfer environment
ENV FREESURFER_HOME="${FS_PREFIX}"
ENV OS="Linux" \
    FS_OVERRIDE=0 \
    FIX_VERTEX_AREA="" \
    FSF_OUTPUT_FORMAT="nii.gz" \
    FREESURFER_HOME="${FREESURFER_HOME}" \
    FREESURFER="${FREESURFER_HOME}" \
    SUBJECTS_DIR="${FREESURFER_HOME}/subjects" \
    FUNCTIONALS_DIR="${FREESURFER_HOME}/sessions" \
    MNI_DIR="${FREESURFER_HOME}/mni" \
    LOCAL_DIR="${FREESURFER_HOME}/local" \
    MINC_BIN_DIR="${FREESURFER_HOME}/mni/bin" \
    MINC_LIB_DIR="${FREESURFER_HOME}/mni/lib" \
    MNI_DATAPATH="${FREESURFER_HOME}/mni/data"
ENV PATH="${FREESURFER_HOME}/bin:${FREESURFER_HOME}/tktools:${MINC_BIN_DIR}:${PATH}"

# set up afni environment
ENV PATH="${AFNI_PREFIX}/abin:${PATH}"

# set up ants environment
ENV PATH="${ANTS_PREFIX}/bin:${PATH}"

# set up fsl environment
ENV FSLDIR="${FSL_PREFIX}"
ENV FSLOUTPUTTYPE="NIFTI_GZ"
ENV PATH="${FSLDIR}/bin:${PATH}"

# set up dcm2niix environment (after FSL so the dedicated build takes
# precedence over the older copy FSL bundles in its own bin/)
ENV PATH="${D2N_PREFIX}:${PATH}"

# AFNI Dependenies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y software-properties-common && \
    add-apt-repository universe && \
    apt-get update && \
    apt-get install -y tcsh xfonts-base libssl-dev       \
                        python-is-python3                 \
                        python3-matplotlib python3-numpy  \
                        python3-flask python3-flask-cors  \
                        python3-pil                       \
                        gsl-bin netpbm gnome-tweaks       \
                        libjpeg62 xvfb xterm vim curl     \
                        gedit evince eog                  \
                        libglu1-mesa-dev libglw1-mesa     \
                        libxm4 build-essential            \
                        libcurl4-openssl-dev libxml2-dev  \
                        gfortran libgomp1                 \
                        gnome-terminal nautilus           \
                        firefox xfonts-100dpi             \
                        r-base-dev cmake bc git           \
                        libgdal-dev libopenblas-dev       \
                        libnode-dev libudunits2-dev       \
                        libinsighttoolkit5.3 && \
   ln -s /usr/lib64/libgsl.so.23 /usr/lib64/libgsl.so.0 && \
   ln -s /usr/lib/x86_64-linux-gnu/libgsl.so.27 /usr/lib/x86_64-linux-gnu/libgsl.so.19

RUN mkdir -p /home/anatqc
ENV HOME=/home/anatqc

# Install ANATQC + branch versions of executors/morphometry (TEST ONLY -
# revert to `RUN pipenv install anatqc=="0.6.0"` once these branches merge
# and are released to PyPI)
ARG ANATQC_PREFIX="/sw/apps/anatqc"
RUN mkdir -p "${ANATQC_PREFIX}"
ENV PIPENV_VENV_IN_PROJECT=1
WORKDIR "${ANATQC_PREFIX}"
RUN pipenv install \
    "git+https://github.com/kakurk/executors.git@feature/sge#egg=executors" \
    "git+https://github.com/kakurk/morphometry.git@feature/8.2.0#egg=morphometry" \
    "git+https://github.com/kakurk/anatqc.git@feature/openmp#egg=anatqc"

# freeview libraries
RUN apt-get install -y libxcb-xinerama0 libxcb-cursor0 libxkbcommon-x11-0 libxcb-xkb1 libxcb-keysyms1 libxcb-icccm4 libxcb-xinput0

# configure entrypoint
WORKDIR /sw/apps/anatqc
ENTRYPOINT ["pipenv", "run", "anatQC.py"]
